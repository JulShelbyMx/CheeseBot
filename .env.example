# ============================================================
#   CheeseBot — Configuration File
#   Copy this file and rename it to: .env
#   Then fill in your values below.
# ============================================================

# ----------------------------------------------------------
# 1. DISCORD BOT TOKEN
#    Where to get it:
#    → Go to https://discord.com/developers/applications
#    → Click "New Application", give it a name
#    → Go to the "Bot" tab on the left
#    → Click "Reset Token" and copy the token
#    → KEEP THIS SECRET — never share it with anyone
# ----------------------------------------------------------
DISCORD_TOKEN=paste_your_bot_token_here

# ----------------------------------------------------------
# 2. CLIENT ID (Application ID)
#    Where to get it:
#    → Same page: https://discord.com/developers/applications
#    → Click your application
#    → On the "General Information" tab, copy "Application ID"
# ----------------------------------------------------------
CLIENT_ID=paste_your_application_id_here

# ----------------------------------------------------------
# 3. DEV GUILD ID (Optional but recommended for testing)
#    This makes slash commands appear instantly on one server
#    instead of waiting up to 1 hour for global deployment.
#    Where to get it:
#    → Open Discord, right-click your server name
#    → Enable Developer Mode first if needed:
#      User Settings → Advanced → Developer Mode ON
#    → Right-click the server → "Copy Server ID"
#    → Remove the # below and paste your ID
# ----------------------------------------------------------
# GUILD_ID=paste_your_server_id_here

# ----------------------------------------------------------
# 4. MONGODB DATABASE URL
#    Free database at: https://www.mongodb.com/atlas
#    Steps:
#    → Create a free account
#    → Create a free "M0" cluster (no credit card needed)
#    → Click "Connect" → "Drivers"
#    → Copy the connection string
#    → Replace <password> with your database user password
# ----------------------------------------------------------
MONGODB_URI=paste_your_mongodb_connection_string_here

# ----------------------------------------------------------
# 5. DEFAULT PREFIX (for legacy prefix commands like !clear)
# ----------------------------------------------------------
DEFAULT_PREFIX=!
